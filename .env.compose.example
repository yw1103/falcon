# Copy to .env in the project root if you need to override these defaults.
FALCON_BIND_HOST=127.0.0.1
FALCON_PORT=8765

# Domestic package sources (already the defaults).
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

# Override with full image names from a registry you can access if Docker Hub
# is unavailable. Keep the same Debian Bookworm image variants.
NODE_IMAGE=node:22-bookworm-slim
PYTHON_IMAGE=python:3.11-slim-bookworm
